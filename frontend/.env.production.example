# ─────────────────────────────────────────────────────────────────────────────
# QRDine Frontend — Production Environment Template
# ─────────────────────────────────────────────────────────────────────────────

# Public backend API URL (reachable from client browsers, must match public domain)
NEXT_PUBLIC_API_URL=https://api.qrdine.yourdomain.com/api

# Public Socket.IO server URL (HTTPS/WSS)
NEXT_PUBLIC_SOCKET_URL=https://api.qrdine.yourdomain.com

# Node environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
