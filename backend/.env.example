# ─────────────────────────────────────────────────────────────────────────────
# QRDine API — environment contract
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the source of
# truth for *which* variables exist and which are mandatory.
#
# The server refuses to start in production if the required keys are missing or
# unsafe (see src/config/env.js). Those checks are covered by tests, so this
# list and the validator cannot drift apart silently.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required in production ──────────────────────────────────────────────────

# Managed, replicating cluster. A local database means every order and customer
# phone number lives on one disk.
#   Production MUST name the database. With no name in the path, Mongoose
#   silently connects to a database called `test` — which looks healthy and
#   holds nothing.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/qrdine?retryWrites=true&w=majority

# Signs admin and customer JWTs. Minimum 32 characters; must not contain
# "change", "test" or "dev" (the validator rejects placeholders).
#   openssl rand -base64 48
JWT_SECRET=

# Exact frontend origin. Used for CORS and must be https in production.
FRONTEND_URL=https://app.example.com

# ── Runtime ─────────────────────────────────────────────────────────────────

PORT=5001
NODE_ENV=development

# Token lifetime for admin sessions. Default 7d.
JWT_EXPIRES_IN=7d

# Public base URLs, used when writing QR / NFC payloads onto physical tags.
# Both must be https in production.
FRONTEND_PUBLIC_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com

# ── Observability (BLOCKER-04) ──────────────────────────────────────────────

# Error tracking. Unset = disabled, and the server logs a loud warning at boot
# in production. Tracking must never be the reason the API fails to start.
SENTRY_DSN=
# Performance traces are off by default; they cost quota fast.
SENTRY_TRACES_SAMPLE_RATE=0

# debug | info | warn | error. Blank = info in production, debug in dev.
LOG_LEVEL=

# ── Email (BLOCKER-03) ──────────────────────────────────────────────────────
# Unset means alerts silently do not send.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ── SMS (Module #09) ────────────────────────────────────────────────────────
# Indian transactional SMS needs DLT clearance (sender ID + template) first.
# While SMS_PROVIDER=console, codes print to the log instead of sending — and
# the server refuses to boot in production with a fixed OTP code set.
SMS_PROVIDER=console
SMS_AUTH_KEY=
SMS_TEMPLATE_ID=

# ── Integrations ────────────────────────────────────────────────────────────

# Server-side only. Never exposed to the browser bundle.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Development only ────────────────────────────────────────────────────────

# Pins every customer sign-in code to one value. This removes the only thing
# standing between someone who knows a customer's phone number and that
# customer's wallet and order history. The server REFUSES to start in
# production while this is set — it is not a warning, it is a boot failure.
#OTP_FIXED_CODE=