{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage --forceExit --detectOpenHandles --verbose",
    "test:watch": "jest --watch",
    "test:auth": "jest --testPathPattern=auth --forceExit",
    "test:orders": "jest --testPathPattern=order --forceExit",
    "test:billing": "jest --testPathPattern=billing --forceExit",
    "backup:verify": "node scripts/scheduled-backup-verify.js",
    "backup:drill": "node scripts/restore-drill.js",
    "pg:rotate-key": "node scripts/rotate-pg-encryption-key.js",
    "start:prod": "pm2 start ecosystem.config.js --env production",
    "stop:prod": "pm2 stop ecosystem.config.js",
    "restart:prod": "pm2 reload ecosystem.config.js --env production",
    "logs:prod": "pm2 logs",
    "monitor": "pm2 monit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.10",
    "pdfkit": "^0.19.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/controllers/**/*.js",
      "src/middlewares/**/*.js",
      "src/utils/**/*.js",
      "!src/docs/**"
    ],
    "coverageDirectory": "coverage",
    "verbose": true,
    "testTimeout": 30000
  }
}
