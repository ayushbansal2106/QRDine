# ─────────────────────────────────────────────────────────────────────────────
# QRDine Backend — Production Environment Template
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5001

# Production MongoDB Atlas Replica Set (with TLS and auth)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/qrdine?retryWrites=true&w=majority

# Strong random secret for signing JWTs (minimum 32 characters, generated via `openssl rand -base64 48`)
JWT_SECRET=generate_a_secure_random_base64_secret_at_least_32_chars_long

# Token lifetimes (recommended: 24h or 7d)
JWT_EXPIRES_IN=24h

# Frontend web application origin for CORS & cookie validation (HTTPS required)
FRONTEND_URL=https://qrdine.yourdomain.com
FRONTEND_PUBLIC_URL=https://qrdine.yourdomain.com
API_PUBLIC_URL=https://api.qrdine.yourdomain.com

# SMTP Server for invoice emails and notifications
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=orders@qrdine.yourdomain.com

# Cloudinary (Optional, for menu dish photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API key (for menu digitization & AI features)
GEMINI_API_KEY=

# Error Tracking (Sentry)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info
